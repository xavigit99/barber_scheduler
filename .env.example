# ── Application ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./barber_scheduler.db
AUTH_SECRET=change-me-in-production
AUTH_TOKEN_TTL_SECONDS=86400
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ── PostgreSQL (usado pelo docker-compose) ────────────────────────────────────
POSTGRES_USER=barber
POSTGRES_PASSWORD=change_me
POSTGRES_DB=barber_scheduler

# ── Email / SMTP (opcional — omitir para usar apenas logs) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=noreply@barberpro.app
SMTP_USE_TLS=true

# ── WhatsApp / CallMeBot (grátis — omitir para usar apenas logs) ──────────────
# Cada barbeiro activa uma vez: adicionar +34 644 59 96 19 aos contactos
# e enviar "I allow callmebot to send me messages" → recebe o apikey
CALLMEBOT_API_KEY=
